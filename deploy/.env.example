# === Docker Compose ENV namunasi ===
# `deploy/.env` ga nusxalab, qiymatlarni to'ldiring.

# Kuchli, tasodifiy kalit (kamida 32 belgi):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=

# Frontend origin (CORS uchun)
FRONTEND_URL=https://osonbiznes.uz

# Birinchi admin (parol kamida 12 belgi)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Obuna to'lovi tushadigan karta (Uzcard/Humo tavsiya etiladi)
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_CARD_BANK=

# AI sotuv agenti kaliti (ixtiyoriy, kamida 24 belgi)
AGENT_API_KEY=
