# === OsonBiznes Backend ENV namunasi ===
# Bu faylni `.env` ga nusxalab, o'z qiymatlaringizni yozing.
# HECH QACHON haqiqiy .env faylni git'ga qo'shmang.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=

# JWT — kuchli, tasodifiy kalit (kamida 32 belgi). Masalan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Telegram Bot token (@BotFather'dan)
TELEGRAM_BOT_TOKEN=

# Boshlang'ich admin akkaunt (seed yaratadi)
ADMIN_EMAIL=admin@osonbiznes.uz
ADMIN_PASSWORD=
ADMIN_NAME=OsonBiznes Admin

# Click to'lov API
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=

# Payme to'lov API
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
