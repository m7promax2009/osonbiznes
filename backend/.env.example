# === OsonBiznes Backend ENV namunasi ===
# Bu faylni `.env` ga nusxalab, o'z qiymatlaringizni yozing.
# HECH QACHON haqiqiy .env faylni git'ga qo'shmang.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=

# JWT — kuchli, tasodifiy kalit (kamida 32 belgi). Masalan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Telegram Bot token (@BotFather'dan)
TELEGRAM_BOT_TOKEN=

# Boshlang'ich admin akkaunt (seed yaratadi)
ADMIN_EMAIL=admin@osonbiznes.uz
# kamida 12 belgi; productionda admin faqat shu orqali yaratiladi
ADMIN_PASSWORD=
ADMIN_NAME=OsonBiznes Admin

# Click to'lov API
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=

# Payme to'lov API
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Obuna to'lovi qabul qilinadigan karta (frontend "Obuna" sahifasida ko'rsatiladi)
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_CARD_BANK=

# Demo ma'lumotlarni productionda yaratish (faqat aniq kerak bo'lsa)
SEED_DEMO=false
# Qo'shimcha ruxsat etilgan frontend domenlari (vergul bilan)
CORS_ORIGINS=
# AI sotuv agenti uchun kalit (kamida 24 belgi)
AGENT_API_KEY=

# AI maslahatchi (aistudio.google.com). Bo'sh bo'lsa oddiy qoidali javoblar ishlaydi
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Email (parolni tiklash / tasdiqlash kodlari). Gmail: smtp.gmail.com, 465, App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OsonBiznes <no-reply@osonbiznes.uz>"
