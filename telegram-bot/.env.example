# === OsonBiznes Telegram Bot ENV namunasi ===
# Bu faylni `.env` ga nusxalab, o'z qiymatlaringizni yozing.

# Telegram Bot token (@BotFather'dan). Backend bilan BIR XIL token.
TELEGRAM_BOT_TOKEN=

# Backend API manzili (bot faqat REST orqali ishlaydi, Mongo'ga to'g'ridan ulanmaydi)
API_URL=http://localhost:5000/api
